{
  "manifest_version": 3,
  "name": "Playwright \u00b7 Guide agent",
  "version": "0.3.0",
  "description": "Queue human guidance for the agent owning the active Playwright tab.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8799/*"
  ],
  "action": {
    "default_title": "Guide the agent in this tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/agent-16.png",
      "32": "icons/agent-32.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/agent-16.png",
    "32": "icons/agent-32.png",
    "48": "icons/agent-48.png",
    "128": "icons/agent-128.png"
  }
}
